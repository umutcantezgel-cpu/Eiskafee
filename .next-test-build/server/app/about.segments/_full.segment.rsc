"meta","46",{"name":"twitter:image","content":"https://hey-fede.de/og/about.png"}],["$","link","47",{"rel":"icon","href":"/icon.svg?icon.0b0t.mn0lki3u.svg","sizes":"any","type":"image/svg+xml"}],["$","$L83","48",{}]]
6f:null
