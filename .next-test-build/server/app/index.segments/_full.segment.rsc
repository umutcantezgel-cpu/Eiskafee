41:["$","div","2",{"className":"bg-[#f5efe8] rounded-[22px] p-[30px_24px] shadow-[0_3px_14px_rgba(45,31,25,0.05)] transition-transform hover:-translate-y-1","children":[["$","div",null,{"className":"relative w-12 h-12 mb-4.5","children":[["$","div",null,{"className":"w-12 h-12 bg-[#E4C0A8] rounded-full flex items-center justify-center","children":["$","$L25",null,{"ref":"$undefined","iconNode":[["path",{"d":"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0","key":"1r0f0z"}],["circle",{"cx":"12","cy":"10","r":"3","key":"ilqhr7"}]],"className":"lucide-map-pin","size":22,"strokeWidth":1.5,"color":"#CC624C"}]}],["$","div",null,{"className":"absolute -bottom-1 -right-1 w-3.5 h-3.5 bg-[#eedfcc] rounded-full border-2 border-[#f5efe8]"}]]}],["$","h3",null,{"className":"font-calistoga text-[1.22rem] text-[#2d1f19] mb-2.5","children":"Tief in Wetzlar verwurzelt"}],["$","p",null,{"className":"font-nunito text-[0.86rem] text-[#7a5a52] leading-[1.7]","children":"Unsere Dessertbar ist mehr als nur ein Café; sie ist unser persönlicher Liebesbrief an die historische Altstadt von Wetzlar. Wir lieben das bunte Treiben rund um den Eisenmarkt, die Spaziergänger auf dem Weg zum Lottehaus und die einzigartige, familiäre Gemeinschaft im Lahn-Dill-Kreis. Wo immer es uns möglich ist, arbeiten wir eng mit lokalen Partnern und Lieferanten zusammen, um die heimische Wirtschaft zu stärken und die Transportwege kurz zu halten. Hey Fede! ist ein lebendiger Treffpunkt für Einheimische und Besucher gleichermaßen – ein Ort, an dem sich die Wetzlarer Geschichte mit modernem, süßem Genuss verbindet."}]]}]
