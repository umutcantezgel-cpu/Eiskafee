efined","iconNode":[["path",{"d":"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2","key":"1yyitq"}],["path",{"d":"M16 3.128a4 4 0 0 1 0 7.744","key":"16gr8j"}],["path",{"d":"M22 21v-2a4 4 0 0 0-3-3.87","key":"kshegd"}],["circle",{"cx":"9","cy":"7","r":"4","key":"nufk8"}]],"className":"lucide-users w-8 h-8 text-[#CC624C]"}]}],["$","h3",null,{"className":"font-calistoga text-2xl text-[#2d1f19] mb-4","children":"Sonntags mit der Familie"}],["$","p",null,{"className":"font-nunito text-[#5c3d35] leading-relaxed text-[0.95rem]","children":"Nach einem langen Spaziergang an der Lahn gibt es nichts Schöneres, als sich gemeinsam aufzuwärmen. Unsere familienfreundliche Dessertbar bietet viel Platz, eine Kinderecke und süße Belohnungen, die garantiert jedes Kinderauge zum Leuchten bringen."}]]}],["$","div","2",{"className":"bg-[#f5efe8] rounded-3xl p-8 border border-peach/50 hover:border-terracotta/50 transition-colors shadow-sm","children":[["$","div",null,{"className":"bg-cream w-16 h-16 rounded-full flex items-center justify-center mb-6 shadow-sm border border-peach/30","children":["$","$L25",null,{"ref":"$undefined","iconNode":[["path",{"d":"M10 2v2","key":"7u0qdc"}],["path",{"d":"M14 2v2","key":"6buw04"}],["path",{"d":"M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1","key":"pwadti"}],["path",{"d":"M6 2v2","key":"colzsn"}]],"className":"lucide-coffee w-8 h-8 text-[#CC624C]"}]}],["$","h3",null,{"className":"font-calistoga text-2xl text-[#2d1f19] mb-4","children":"Der entspannte After-Work"}],["$","p",null,{"className":"font-nunito text-[#5c3d35] leading-relaxed text-[0.95rem]","children":"Lass den anstrengenden Büroalltag einfach hinter dir. Ein aromatischer Espresso, ein frisch gebackener Crêpe und gute Gespräche mit Kollegen in gemütlicher Atmosphäre sind die beste Art, den verdienten Feierabend in Wetzlar einzuläuten."}]]}],["$","div","3",{"className":"bg-[#f5efe8] rounded-3xl p-8 border border-peach/50 hover:border-terracotta/50 transiti